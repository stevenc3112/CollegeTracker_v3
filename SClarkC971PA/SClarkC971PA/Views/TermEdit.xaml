<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SClarkC971PA.Views.TermEdit">
    <NavigationPage.TitleView>
        <Grid ColumnDefinitions="Auto, *, Auto" Padding="10" VerticalOptions="Center">

            <Label Text="Edit/Add Term"
               x:Name="EditAddTermTitle"
               FontSize="Title"
               TextColor="Black"
               FontAttributes="Bold"
               VerticalOptions="Center"
               HorizontalOptions="Center"
               Grid.Column="1"/>

        </Grid>
    </NavigationPage.TitleView>
    <Grid RowDefinitions="*, Auto, Auto">

        <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*,50, *" VerticalOptions="Fill" HorizontalOptions="CenterAndExpand" Grid.Row="0">
            <Label Text="Term Title:" Grid.Row="0" Grid.Column="0" Padding="5" FontSize="Medium" VerticalOptions="Center" HorizontalOptions="Center" />
            <Entry x:Name="TermTitleEntry" Grid.Row="0" Grid.Column="2" FontSize="Medium" VerticalOptions="Center"  BackgroundColor="WhiteSmoke"/>

            <Label Text="Start Date" Grid.Row="1" Grid.Column="0" FontSize="Medium" VerticalOptions="Center" HorizontalOptions="CenterAndExpand"/>
            <DatePicker x:Name="StartDateDpkr" Grid.Row="1" Grid.Column="2" FontSize="Medium" VerticalOptions="Center" HorizontalOptions="Fill" BackgroundColor="WhiteSmoke"/>
            
            <Label Text="End Date" Grid.Row="2" Grid.Column="0" FontSize="Medium" VerticalOptions="Center" HorizontalOptions="CenterAndExpand"/>
            <DatePicker x:Name="EndDateDpkr" Grid.Row="2" Grid.Column="2" FontSize="Medium" VerticalOptions="Center" HorizontalOptions="Fill" BackgroundColor="WhiteSmoke"/>
        </Grid>
        <Label x:Name="TermErrorLbl" FontSize="Medium" TextColor="Red" IsVisible="False" Grid.Row="1" Text="Term Error Label"/>
        <Grid RowDefinitions="Auto" Grid.Row="2">
            <Button x:Name="SaveTermBtn" Text="Save"
                Grid.Row="0"
                FontSize="Medium"
                Padding="20"
                Clicked="SaveTermBtn_Clicked"   
                HorizontalOptions="Fill"
                BackgroundColor="#46B1EF"
                BorderColor="#C8C8C8"
                TextColor="Black"
                BorderWidth="1"/>
        </Grid>
    </Grid>
</ContentPage>