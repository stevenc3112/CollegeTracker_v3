<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SClarkC971PA.Views.TermCourseList">
    <NavigationPage.TitleView>
        <Grid ColumnDefinitions="Auto, *, Auto" Padding="10" VerticalOptions="Center">

            <Label Text="Term Courses"
                   x:Name="TermNameTitle"
                   FontSize="Title"
                   TextColor="Black"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   Grid.Column="1"/>

        </Grid>
    </NavigationPage.TitleView>

    <ContentPage.Content>
        <Grid RowDefinitions="Auto, Auto, *">
            <Grid ColumnDefinitions="*,*,*" Grid.Row="0">
                <Label x:Name="TermStartLbl"
                   Text="TermStartDate"
                   FontSize="Small"
                   HorizontalOptions="Center"
                   Grid.Column="0"/>
                <Label
                   Text="-"
                   FontSize="Header"
                   HorizontalOptions="Center"
                   Grid.Column="1"/>
                <Label x:Name="TermEndLbl"
                   Text="TermEndDate"
                   FontSize="Small"
                   HorizontalOptions="Center"
                   Grid.Column="2"/>
            </Grid>

            <Grid RowDefinitions="Auto, Auto, Auto" Grid.Row="1">
                <Button x:Name="EditTermBtn"
                    Text="Edit Term"
                    Grid.Row="0"
                    FontSize="Medium"
                    Padding="20"
                    Clicked="EditTermBtn_Clicked"
                    HorizontalOptions="Fill"
                    BackgroundColor="#78BE43"
                    BorderColor="#C8C8C8"
                    TextColor="Black"
                    BorderWidth="1"/>
                <Button x:Name="AddCourseBtn" 
                    Text="Add Course"
                    Grid.Row="1"
                    FontSize="Medium"
                    Padding="20"
                    Clicked="AddCourseBtn_Clicked" 
                    HorizontalOptions="Fill"
                    BackgroundColor="#46B1EF"
                    BorderColor="#C8C8C8"
                    TextColor="Black"
                    BorderWidth="1"/>
                <Button x:Name="DeleteTermBtn" Text="Delete Term"
                    Grid.Row="2"
                    FontSize="Medium"
                    Padding="20"
                    Clicked="DeleteTermBtn_Clicked"   
                    HorizontalOptions="Fill"
                    BackgroundColor="Red"
                    BorderColor="#C8C8C8"
                    TextColor="Black"
                    BorderWidth="1"/>
            </Grid>
            <Border StrokeShape="RoundRectangle 10"
                    Padding="10"
                    BackgroundColor="WhiteSmoke" Grid.Row="2">


                <CollectionView x:Name="CourseCollectionView"
                                ItemsSource="{Binding Course}"
                                EmptyView="No courses to display."
                                SelectionMode="Single"
                                SelectionChanged="CourseCollectionView_SelectionChanged">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                    </CollectionView.ItemsLayout>


                    <!--Define the appearance of each item in the list-->
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 10"
                                    BackgroundColor="#46B1EF"
                                    Padding="10">

                                <StackLayout>
                                    <Grid Padding="5" RowSpacing="1" ColumnSpacing="22" BackgroundColor="#46B1EF" >
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="25"/>
                                            <RowDefinition Height="25"/>
                                            <RowDefinition Height="25"/>

                                        </Grid.RowDefinitions>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>

                                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding CourseName}" FontSize="Medium" VerticalTextAlignment="Center" FontAttributes="Bold" HorizontalTextAlignment="Center"/>

                                        <Label Grid.Row="1" Grid.Column="0" Text="{Binding CourseStartDate, StringFormat='{0:M/dd/yyyy}'}" FontSize="Micro"  VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>
                                        <Label Grid.Row="1" Grid.Column="1" Text="-" FontSize="Medium"  VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>
                                        <Label Grid.Row="1" Grid.Column="2" Text="{Binding CourseEndDate, StringFormat='{0:M/dd/yyyy}'}" FontSize="Micro"  VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>

                                    </Grid>
                                </StackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>
            </Border>
        </Grid>

    </ContentPage.Content>
</ContentPage>